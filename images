       活動卡片
    ========================== */

    .grid {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 20px;
    }

    .card {

      background: white;

      border-radius: 18px;

      overflow: hidden;

      box-shadow:
        0 6px 22px rgba(0,0,0,0.08);

      transition: transform .25s;
