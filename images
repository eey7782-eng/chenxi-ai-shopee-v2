<!DOCTYPE html>
<html lang="zh-Hant">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>媽祖田休閒農場</title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "Noto Sans TC",
        Arial,
        sans-serif;

      background: #f4f6f8;
      color: #333;
    }

    /* =========================
       頁首
    ========================== */

    header {
      background: linear-gradient(
        135deg,
        #2c7a4b,
        #17452a
      );

      color: white;
      text-align: center;
      padding: 60px 20px;
    }

    header h1 {
      margin: 0;

      font-size: 2.5rem;

      letter-spacing: 4px;
    }

    .subtitle {
      margin-top: 18px;

      font-size: 1.1rem;

      line-height: 2;
    }

    .contact {
      margin-top: 20px;

      line-height: 2;
    }

    .contact a {
      color: #ffd700;

      text-decoration: none;

      font-weight: bold;
    }


    /* =========================
       主要內容
    ========================== */

    main {
      max-width: 1100px;

      margin: 40px auto;

      padding: 0 20px;
    }


    /* =========================
       卡片
    ========================== */

    .card {
      background: white;

      margin-bottom: 30px;

      padding: 25px;

      border-radius: 18px;

      box-shadow:
        0 5px 20px
        rgba(0, 0, 0, 0.08);
    }

    .card h2 {
      color: #2c7a4b;

      margin-top: 0;

      font-size: 1.5rem;

      border-bottom:
        2px solid #e5e7eb;

      padding-bottom: 12px;
    }

    .card p {
      line-height: 1.9;

      color: #555;
    }


    /* =========================
       服務
    ========================== */

    .services {
      display: grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap: 15px;

      margin-top: 20px;
    }

    .service {
      background: #f5faf6;

      padding: 20px;

      border-radius: 12px;

      text-align: center;

      font-size: 1.1rem;

      border:
        1px solid #dcefe2;
    }


    /* =========================
       圖片區
    ========================== */

    .photo-box {
      margin-top: 20px;

      width: 100%;

      min-height: 220px;

      border-radius: 15px;

      background:
        linear-gradient(
          135deg,
          #e7efe9,
          #d6e4da
        );

      display: flex;

      align-items: center;

      justify-content: center;

      text-align: center;

      color: #52705d;

      font-size: 1.1rem;

      padding: 30px;
    }


    /* =========================
       預約
    ========================== */

    .booking {
      text-align: center;

      background:
        linear-gradient(
          135deg,
          #fff8e1,
          #fffdf5
        );
    }

    .phone-button {
      display: inline-block;

      margin-top: 15px;

      padding: 14px 28px;

      background: #2c7a4b;

      color: white;

      text-decoration: none;

      border-radius: 30px;

      font-weight: bold;
    }


    /* =========================
       頁尾
    ========================== */

    footer {
      background: #173c25;

      color: white;

      text-align: center;

      padding: 35px 20px;

      line-height: 2;
    }

    footer p {
      margin: 5px;
    }


    /* =========================
       手機版
    ========================== */

    @media (max-width: 600px) {

      header {
        padding: 45px 15px;
      }

      header h1 {
        font-size: 2rem;
      }

      .services {
        grid-template-columns: 1fr;
      }

      main {
        padding: 0 15px;
      }

      .card {
        padding: 20px;
      }

    }

  </style>

</head>


